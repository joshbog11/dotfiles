# Ghostty configuration. Reload with Cmd-Shift-, (comma).
# Rex is built on the same engine but keeps its appearance in its own Settings;
# use "Import Theme File" there with ~/.config/ghostty/themes/tinted-theming.

# ── Font ─────────────────────────────────────────────────────
# Ghostty has Nerd Font symbols built in, so the plain font is enough.
font-family = ""
font-family = JetBrains Mono
font-size = 14
font-feature = calt
font-feature = liga

# ── Theme (generated by Tinty; change it with `theme`) ───────
theme = tinted-theming

# Transparency: uncomment, then turn on <leader>ub in Neovim.
# background-opacity = 0.92
# background-blur = 20

# ── Window ───────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# ── Behaviour ────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
# Left Option is Alt (needed for Alt-j/k line moves and Alt-Shift-h/l in tmux);
# right Option still types characters such as # on a UK keyboard.
macos-option-as-alt = left

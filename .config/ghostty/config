# Font
font-family = ""
font-family = JetBrains Mono
font-size = 14

font-feature = calt
font-feature = liga

# Theme is generated by Tinty
theme = tinted-theming

# Window
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true
